{
  "expo": {
    "name": "БлагоСити",
    "description": "Городская система помощи инвалидам и лицам с ограниченными возможностями",
    "slug": "blagocity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "blagocity",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "package": "com.anonymous.blagocity"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 61
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/LexendDeca-Bold.ttf",
            "./assets/fonts/LexendDeca-ExtraLight.ttf",
            "./assets/fonts/LexendDeca-Medium.ttf",
            "./assets/fonts/LexendDeca-Regular.ttf",
            "./assets/fonts/LexendDeca-SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "./assets/video/intro.mp4",
            "./assets/images/logo.png",
            "./assets/images/onboarding/places.png",
            "./assets/images/onboarding/clans.png",
            "./assets/images/onboarding/discounts.png"
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
